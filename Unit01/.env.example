# ===================== GESTEL API (Unit01) =====================
# MODELE : copier en .env puis remplacer les valeurs PASSWORD_* par de vrais secrets

# ---------- serveur API ----------
APP_HOST=127.0.0.1          # 0.0.0.0 pour ecouter sur toutes les interfaces
APP_PORT=8000               # port d'ecoute d'uvicorn (local ET dans le conteneur)
APP_HOST_PORT=8000          # port publie sur la machine par docker compose

# ---------- MySQL ----------
MYSQL_HOST=127.0.0.1        # depuis la machine hote (docker compose remplace par "mysql")
MYSQL_PORT=3306             # port interne du conteneur MySQL
MYSQL_HOST_PORT=3307        # port publie sur la machine (3306 est deja pris par le MySQL local)
MYSQL_DATABASE=gestel
MYSQL_USER=gestel
MYSQL_PASSWORD=PASSWORD_MYSQL_PASSWORD
MYSQL_ROOT_PASSWORD=PASSWORD_MYSQL_ROOT_PASSWORD
# ${VAR} est remplace par python-dotenv (et par docker compose)
DATABASE_URL=mysql+pymysql://${MYSQL_USER}:${MYSQL_PASSWORD}@${MYSQL_HOST}:${MYSQL_HOST_PORT}/${MYSQL_DATABASE}
SQLITE_FALLBACK_URL=sqlite:///./gestel.db

# ---------- securite ----------
SECRET_KEY=PASSWORD_SECRET_KEY
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------- compte admin de demo ----------
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=PASSWORD_ADMIN_PASSWORD
