# Book&Ride - Unit 04 (gateway + microservices). MODELE : cp .env.example .env puis remplacer PASSWORD_*

# ---------- gateway (the ONLY published entry point) ----------
GATEWAY_PORT=8000
GATEWAY_LISTEN_PORT=80
RATE_LIMIT=10r/s
RATE_BURST=20
# API keys -> user ids 1 and 2 (checked by the gateway)
API_KEY_USER1=PASSWORD_API_KEY_USER1
API_KEY_USER2=PASSWORD_API_KEY_USER2

# ---------- books service (former monolith) + its database ----------
API_PORT=8080
APP_VERSION=0.1.0
DB_USER=app
DB_PASSWORD=PASSWORD_DB_PASSWORD
DB_NAME=bookandride
DB_HOST=db
DB_PORT=5432

# ---------- rentals microservice + its OWN database ----------
RENTALS_PORT=8080
RENTALS_VERSION=0.2.0
RENTALS_DB_USER=rentals
RENTALS_DB_PASSWORD=PASSWORD_RENTALS_DB_PASSWORD
RENTALS_DB_NAME=rentals
RENTALS_DB_HOST=rentals-db
RENTALS_DB_PORT=5432

# ---------- monitoring (optional: docker compose --profile monitoring up -d) ----------
PROMETHEUS_PORT=9090
