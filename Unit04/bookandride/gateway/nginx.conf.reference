# REFERENCE ONLY (not mounted): the lab's final nginx.conf with fixed values.
# The running gateway uses gateway/templates/default.conf.template (values from .env).

# ---------- rate limiting: 10 requests/second per client IP ----------
limit_req_zone $binary_remote_addr zone=perip:10m rate=10r/s;

# ---------- API key -> user id ("" = unknown key) ----------
map $http_x_api_key $api_user {
    default          "";
    "dev-key-123"    "1";
    "dev-key-456"    "2";
}

# ---------- upstream services (= Docker Compose service names) ----------
upstream books_service   { server api:8080; }
upstream rentals_service { server rentals:8080; }

server {
    listen 80;
    default_type application/json;

    limit_req zone=perip burst=20 nodelay;
    limit_req_status 429;

    # the gateway's own health check
    location = /health {
        return 200 '{"status":"ok","component":"gateway"}';
    }

    # health checks of the services: public, no API key
    location = /books/health   { proxy_pass http://books_service/health; }
    location = /rentals/health { proxy_pass http://rentals_service/rentals/health; }

    # public route: books (no API key needed)
    location /books {
        proxy_pass http://books_service;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # protected route: rentals (the API key is checked HERE)
    location /rentals {
        if ($api_user = "") {
            return 401 '{"detail":"Missing or invalid API key"}';
        }
        proxy_pass http://rentals_service;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-User-Id $api_user;   # overwrites any value sent by the client
    }

    # everything else
    location / {
        return 404 '{"detail":"Unknown route"}';
    }
}