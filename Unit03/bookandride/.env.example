# Book&Ride - Unit 03 (monolith). MODELE : cp .env.example .env puis remplacer PASSWORD_*
# ---------- PostgreSQL ----------
DB_USER=app
DB_PASSWORD=PASSWORD_DB_PASSWORD
DB_NAME=bookandride
DB_HOST=db
DB_PORT=5432
# URL utilisee par l'API ; docker compose remplace les ${...}
DATABASE_URL=postgresql+psycopg://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
# ---------- API ----------
API_PORT=8080
API_HOST_PORT=8080
APP_VERSION=0.1.0
